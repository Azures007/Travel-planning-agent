# PostgreSQL 连接（Docker Compose 端口 5433）
DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5433/travel_agent

# 阿里百炼 DashScope（OpenAI 兼容接口）
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus

# 真实数据 API（留空自动降级 Mock）
# 高德开放平台: https://lbs.amap.com/
AMAP_KEY=
# 和风天气: https://dev.qweather.com/
QWEATHER_KEY=
# 和风专属 API Host（2026 年起必须用账号专属域名，控制台「设置→API Host」查看）
# 示例: https://xxxxxxx.qweatherapi.com
QWEATHER_HOST=https://devapi.qweather.com
QWEATHER_GEO_HOST=https://geoapi.qweather.com
# 开发期强制用 Mock（true 时忽略上面两个 Key）
FORCE_MOCK_TOOLS=false

# 上下文压缩（长对话时把旧消息压成摘要，默认值通常够用）
# CONTEXT_COMPRESS_THRESHOLD=24000
# CONTEXT_KEEP_RECENT=12

# CORS
CORS_ORIGINS=http://localhost:5173
